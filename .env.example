# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit real keys.

# 本机单用户学习模式：不连接 Supabase，不需要登录。
APP_MODE=local
LOCAL_DATA_DIR=.local

# --- LLM provider ---
# Which provider to use for all LLM calls.
#   "groq"   — Groq
#   "gemini" — Google AI Studio
#   "openai_compatible" — 标准 Chat Completions 接口，需支持工具调用/结构化输出
LLM_PROVIDER=openai_compatible

# --- 之后填写的兼容模型接口 ---
# 使用这一组时，把上方 LLM_PROVIDER 改为 openai_compatible。
# 地址按服务文档填写，通常包含 /v1；不要把密钥放进地址。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Groq (recommended) ---
# Get a key at https://console.groq.com (free tier, no credit card)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini (alternative) ---
# Get a key at https://aistudio.google.com
GEMINI_API_KEY=
PRIMARY_MODEL=gemini-2.0-flash
VALIDATOR_MODEL=gemini-2.0-flash

# --- App settings ---
LOG_LEVEL=INFO
MAX_AGENT_RETRIES=3
MAX_INVESTIGATION_STEPS=6
MAX_MODEL_CALLS_PER_TASK=30

# --- Session memory ---
# "memory" — process-local, lost on restart (good for tests / offline dev)
# "sqlite" — local single-user database, no Supabase account required
# "supabase" — Postgres via Supabase, persistent across restarts and days
SESSION_BACKEND=sqlite
# Sessions never auto-expire (0 = no TTL). Users delete via the UI.
SESSION_TTL_SECONDS=0
# 应用对话记忆额度（估算 Token），80%触发摘要；非模型官方窗口。
CONTEXT_MEMORY_TOKENS=16000
# 以下仅原云模式需要；APP_MODE=local 时留空。
# Get these at https://supabase.com → Project Settings → API
# Use the legacy service_role key (starts with eyJ...), NOT the new sb_secret_ format
# (the Python client doesn't support the new format yet as of 2026).
SUPABASE_URL=
SUPABASE_KEY=
# JWT secret for validating auth tokens. Found in Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# --- Safety / rate limits ---
# Hard timeout per SQL query (seconds). Pathological queries are killed.
SQL_TIMEOUT_SECONDS=10
# Leave empty for native Docker; set an existing WSL2 distro on Windows if needed.
DOCKER_WSL_DISTRO=
# Per-IP rate limits. Format: <count>/<minute|second|hour|day>
RATE_LIMIT_ASK=10/minute
RATE_LIMIT_DEFAULT=60/minute
# CORS allow-list. Comma-separated origins, or '*' for any (dev only).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
